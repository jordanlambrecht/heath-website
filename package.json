{
  "name": "heaths-poetry-website",
  "version": "1.0.0",
  "description": "Heath's poetry website",
  "author": "Jordan Lambrecht",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:db-schema": "cross-env NODE_OPTIONS=--no-deprecation payload generate:db-schema",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation next lint --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "migrate:dev": "dotenv -e .env.development.local -- pnpm payload migrate",
    "migrate:prod": "dotenv -e .env.production.local -- pnpm payload migrate"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.52.0",
    "@payloadcms/email-nodemailer": "^3.52.0",
    "@payloadcms/next": "^3.52.0",
    "@payloadcms/plugin-nested-docs": "^3.52.0",
    "@payloadcms/plugin-redirects": "^3.52.0",
    "@payloadcms/plugin-seo": "^3.52.0",
    "@payloadcms/richtext-lexical": "^3.52.0",
    "@payloadcms/storage-vercel-blob": "^3.52.0",
    "@payloadcms/ui": "^3.52.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.0.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.12",
    "geist": "^1.4.2",
    "graphql": "^16.11.0",
    "lucide-react": "^0.540.0",
    "next": "^15.4.7",
    "next-plausible": "^3.12.4",
    "next-sitemap": "^4.2.3",
    "next-transition-router": "^0.2.11",
    "payload": "^3.52.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.34.3",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@tailwindcss/typography": "^0.5.16",
    "@types/escape-html": "^1.0.4",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "copyfiles": "^2.4.1",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.33.0",
    "eslint-config-next": "^15.4.7",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2"
  }
}
